{
  "name": "grkd-jisho",
  "private": true,
  "version": "0.1.1",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:bot": "bun --filter @grkd-jisho/bot dev",
    "dev:web": "pnpm --filter web dev",
    "test": "bun --filter @grkd-jisho/bot test",
    "test:watch": "bun --filter @grkd-jisho/bot test:watch",
    "db:generate": "bun --filter @grkd-jisho/db generate",
    "db:migrate": "bun --filter @grkd-jisho/db migrate",
    "db:import": "bun --filter @grkd-jisho/db import-yomitan",
    "db:seed": "bun --filter @grkd-jisho/db seed-defaults",
    "bot:register": "bun --filter @grkd-jisho/bot register-commands",
    "db:backup": "bun --filter @grkd-jisho/db db:backup",
    "db:backup:dry": "bun --filter @grkd-jisho/db db:backup:dry",
    "db:backup:list": "bun --filter @grkd-jisho/db db:backup:list"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
